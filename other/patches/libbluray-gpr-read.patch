     return ((uint64_t)out_time) * 2;
 }
 
+uint32_t bd_get_gpr(BLURAY *bd, unsigned reg)
+{
+    if (!bd || reg >= 4096)
+        return 0;
+    bd_mutex_lock(&bd->mutex);
+    uint32_t value = bd_gpr_read(bd->regs, reg);
+    bd_mutex_unlock(&bd->mutex);
+    return value;
+}
+
